      <bpmn:outgoing>Flow_65_e6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BoundaryEvent_65_b2" name="Revízia neúspešná" attachedToRef="SubProcess_65_sp2" cancelActivity="true">
