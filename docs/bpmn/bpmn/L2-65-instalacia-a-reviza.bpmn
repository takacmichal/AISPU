      <bpmn:outgoing>Flow_65_e5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BoundaryEvent_65_b1" name="Chýba alebo je chybný komponent" attachedToRef="SubProcess_65_sp1" cancelActivity="true">
      <bpmn:outgoing>Flow_65_e7</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_65_b1" errorRef="Error_65_b1" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_65_f1" name="Doobjednať alebo vymeniť komponent">
