      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_61_s" name="Dopyt zákazníka">
      <bpmn:outgoing>Flow_61_e1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_61_s" />
    </bpmn:startEvent>
    <bpmn:task id="Task_61_t1" name="Zaznamenať zákazníka a odberné miesto">
      <bpmn:incoming>Flow_61_e1</bpmn:incoming>
      <bpmn:outgoing>Flow_61_e2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_61_t2" name="Zostaviť cenovú ponuku z komponentov">
      <bpmn:incoming>Flow_61_e2</bpmn:incoming>
      <bpmn:incoming>Flow_61_e8</bpmn:incoming>
      <bpmn:outgoing>Flow_61_e3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_61_t3" name="Odoslať ponuku zákazníkovi">
      <bpmn:incoming>Flow_61_e3</bpmn:incoming>
      <bpmn:outgoing>Flow_61_e4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_61_c" name="Odpoveď zákazníka">
      <bpmn:incoming>Flow_61_e4</bpmn:incoming>
      <bpmn:outgoing>Flow_61_e5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_61_c" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_61_g" name="Ponuka schválená?">
      <bpmn:incoming>Flow_61_e5</bpmn:incoming>
      <bpmn:outgoing>Flow_61_e6</bpmn:outgoing>
      <bpmn:outgoing>Flow_61_e7</bpmn:outgoing>
      <bpmn:outgoing>Flow_61_e8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_61_ok" name="Ponuka prijatá → návrh FVE (#62)">
      <bpmn:incoming>Flow_61_e6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_61_no" name="Ponuka zamietnutá">
      <bpmn:incoming>Flow_61_e7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_61_e1" name="" sourceRef="StartEvent_61_s" targetRef="Task_61_t1" />
    <bpmn:sequenceFlow id="Flow_61_e2" name="" sourceRef="Task_61_t1" targetRef="Task_61_t2" />
