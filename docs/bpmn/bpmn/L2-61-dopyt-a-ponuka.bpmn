    <bpmn:sequenceFlow id="Flow_61_e5" name="" sourceRef="Event_61_c" targetRef="Gateway_61_g" />
    <bpmn:sequenceFlow id="Flow_61_e6" name="áno" sourceRef="Gateway_61_g" targetRef="EndEvent_61_ok" />
    <bpmn:sequenceFlow id="Flow_61_e7" name="nie, zamietnutá" sourceRef="Gateway_61_g" targetRef="EndEvent_61_no" />
    <bpmn:sequenceFlow id="Flow_61_e8" name="žiada úpravu" sourceRef="Gateway_61_g" targetRef="Task_61_t2" />
  </bpmn:process>
