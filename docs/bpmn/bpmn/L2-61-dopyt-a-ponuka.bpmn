  <bpmn:process id="Process_61" name="SolarOps (firma) – #61 Dopyt a ponuka" isExecutable="false">
    <bpmn:documentation>Roly: Obchod (vykonáva proces), Zákazník (black-box pool).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_61">
      <bpmn:lane id="Lane_61_lane0" name="Obchod">
        <bpmn:flowNodeRef>StartEvent_61_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_61_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_61_t2</bpmn:flowNodeRef>
