  <bpmn:process id="Process_67" name="SolarOps (firma) – #67 Servis z hlásenia" isExecutable="false">
    <bpmn:documentation>Roly: Obchod (prijatie, triedenie, diaľková diagnostika, uzavretie), Technik (výjazd, zásah, overenie výroby), Zákazník (black-box pool).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_67">
      <bpmn:lane id="Lane_67_lane0" name="Obchod">
        <bpmn:flowNodeRef>StartEvent_67_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_67_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_67_t1b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_67_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_67_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_67_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_67_x</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_67_lane1" name="Technik">
        <bpmn:flowNodeRef>Task_67_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_67_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_67_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_67_t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_67_s" name="Hlásenie poruchy od zákazníka">
      <bpmn:outgoing>Flow_67_e1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_67_s" />
    </bpmn:startEvent>
    <bpmn:task id="Task_67_t1" name="Prijať hlásenie a vytvoriť tiket">
      <bpmn:incoming>Flow_67_e1</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_67_t1b" name="Roztriediť tiket (typ, priorita)">
      <bpmn:incoming>Flow_67_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_67_t2" name="Diagnostikovať poruchu na diaľku">
      <bpmn:incoming>Flow_67_e3</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_67_g" name="Vyriešené na diaľku?">
      <bpmn:incoming>Flow_67_e4</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e5</bpmn:outgoing>
      <bpmn:outgoing>Flow_67_e6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_67_t3" name="Naplánovať výjazd technika">
      <bpmn:incoming>Flow_67_e6</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_67_t4" name="Opraviť alebo vymeniť komponent na mieste">
      <bpmn:incoming>Flow_67_e7</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_67_t5" name="Zapísať servisný zásah">
      <bpmn:incoming>Flow_67_e8</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_67_t6" name="Overiť obnovenie výroby">
      <bpmn:incoming>Flow_67_e9</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_67_t7" name="Uzavrieť tiket a informovať zákazníka">
      <bpmn:incoming>Flow_67_e5</bpmn:incoming>
      <bpmn:incoming>Flow_67_e10</bpmn:incoming>
      <bpmn:outgoing>Flow_67_e11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_67_x" name="Tiket uzavretý">
