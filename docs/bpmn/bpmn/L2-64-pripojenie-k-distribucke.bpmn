  <bpmn:process id="Process_64" name="SolarOps (firma) – #64 Pripojenie" isExecutable="false">
    <bpmn:documentation>Roly: Obchod (príprava podkladov, doplnenie, zmluva zákazníkovi), Projektant (žiadosť a komunikácia s distribučkou), Zákazník a Distribučka (black-box pooly).</bpmn:documentation>
