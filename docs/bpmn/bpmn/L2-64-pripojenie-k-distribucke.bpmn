    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_64_s" name="Zmluva a záloha prijaté">
      <bpmn:outgoing>Flow_64_e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_64_t1" name="Pripraviť podklady pre pripojenie">
