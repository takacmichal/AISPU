<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_L1" targetNamespace="http://solarops.example/bpmn" exporter="SolarOps docs (konverzia z solarops-bpmn.drawio)" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_L1">
    <bpmn:participant id="Participant_L1_SolarOps" name="SolarOps (firma)" processRef="Process_L1" />
    <bpmn:participant id="Participant_L1_Z" name="Zákazník" />
    <bpmn:participant id="Participant_L1_D" name="Distribučka" />
    <bpmn:messageFlow id="MessageFlow_L1_e9" name="Dopyt" sourceRef="Participant_L1_Z" targetRef="StartEvent_L1_s" />
    <bpmn:messageFlow id="MessageFlow_L1_e10" name="Cenová ponuka" sourceRef="Task_L1_a" targetRef="Participant_L1_Z" />
    <bpmn:messageFlow id="MessageFlow_L1_e11" name="Podpísaná zmluva a záloha" sourceRef="Participant_L1_Z" targetRef="Task_L1_c" />
    <bpmn:messageFlow id="MessageFlow_L1_e12" name="Žiadosť o pripojenie" sourceRef="Task_L1_d" targetRef="Participant_L1_D" />
    <bpmn:messageFlow id="MessageFlow_L1_e13" name="Zmluva o pripojení" sourceRef="Participant_L1_D" targetRef="Task_L1_d" />
    <bpmn:messageFlow id="MessageFlow_L1_e14" name="Oznámenie o pripojení" sourceRef="Participant_L1_D" targetRef="Task_L1_f" />
    <bpmn:messageFlow id="MessageFlow_L1_e15" name="Protokol o odovzdaní" sourceRef="Task_L1_f" targetRef="Participant_L1_Z" />
    <bpmn:messageFlow id="MessageFlow_L1_e16" name="Hlásenie poruchy" sourceRef="Participant_L1_Z" targetRef="Task_L1_g" />
  </bpmn:collaboration>
  <bpmn:process id="Process_L1" name="SolarOps (firma) – L1 Prehľad" isExecutable="false">
    <bpmn:documentation>Kolaborácia L1: SolarOps (lanes Obchod, Projektant, Technik) a black-box účastníci Zákazník a Distribučka.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L1">
      <bpmn:lane id="Lane_L1_lane0" name="Obchod">
        <bpmn:flowNodeRef>StartEvent_L1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L1_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L1_c</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L1_lane1" name="Projektant">
        <bpmn:flowNodeRef>Task_L1_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L1_d</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L1_lane2" name="Technik">
        <bpmn:flowNodeRef>Task_L1_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L1_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L1_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_L1_x</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_L1_s" name="Dopyt zákazníka">
      <bpmn:outgoing>Flow_L1_e1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_L1_s" />
    </bpmn:startEvent>
    <bpmn:task id="Task_L1_a" name="Dopyt a cenová ponuka (#61)">
      <bpmn:incoming>Flow_L1_e1</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_e2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L1_b" name="Návrh FVE projektantom (#62)">
      <bpmn:incoming>Flow_L1_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_e3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L1_c" name="Uzatvorenie zmluvy a platba zálohy (#63)">
      <bpmn:incoming>Flow_L1_e3</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_e4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L1_d" name="Žiadosť o pripojenie k distribučke (#64)">
      <bpmn:incoming>Flow_L1_e4</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_e5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L1_e" name="Inštalácia a revízia (#65)">
      <bpmn:incoming>Flow_L1_e5</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_e6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L1_f" name="Uvedenie do prevádzky a odovzdanie (#66)">
      <bpmn:incoming>Flow_L1_e6</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_e7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L1_g" name="Servis a prediktívna údržba (#67, #68)">
      <bpmn:incoming>Flow_L1_e7</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_e8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_L1_x" name="FVE v prevádzke">
      <bpmn:incoming>Flow_L1_e8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L1_e1" name="" sourceRef="StartEvent_L1_s" targetRef="Task_L1_a" />
    <bpmn:sequenceFlow id="Flow_L1_e2" name="" sourceRef="Task_L1_a" targetRef="Task_L1_b" />
    <bpmn:sequenceFlow id="Flow_L1_e3" name="" sourceRef="Task_L1_b" targetRef="Task_L1_c" />
    <bpmn:sequenceFlow id="Flow_L1_e4" name="" sourceRef="Task_L1_c" targetRef="Task_L1_d" />
    <bpmn:sequenceFlow id="Flow_L1_e5" name="" sourceRef="Task_L1_d" targetRef="Task_L1_e" />
    <bpmn:sequenceFlow id="Flow_L1_e6" name="" sourceRef="Task_L1_e" targetRef="Task_L1_f" />
    <bpmn:sequenceFlow id="Flow_L1_e7" name="" sourceRef="Task_L1_f" targetRef="Task_L1_g" />
    <bpmn:sequenceFlow id="Flow_L1_e8" name="" sourceRef="Task_L1_g" targetRef="EndEvent_L1_x" />
  </bpmn:process>
