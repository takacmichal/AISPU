  </bpmn:collaboration>
  <bpmn:process id="Process_66" name="SolarOps (firma) – #66 Uvedenie do prevádzky" isExecutable="false">
    <bpmn:documentation>Roly: Technik (funkčná skúška, spustenie, odovzdanie), Obchod (podklady k zmluve o dodávke, preberací protokol), Zákazník a Distribučka (black-box pooly).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_66">
      <bpmn:lane id="Lane_66_lane0" name="Obchod">
        <bpmn:flowNodeRef>Task_66_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_66_c3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_66_x</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_66_lane1" name="Technik">
        <bpmn:flowNodeRef>StartEvent_66_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_66_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_66_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_66_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_66_c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_66_c2</bpmn:flowNodeRef>
