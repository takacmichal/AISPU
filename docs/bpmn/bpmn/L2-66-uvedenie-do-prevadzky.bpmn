    <bpmn:participant id="Participant_66_Z" name="Zákazník" />
    <bpmn:participant id="Participant_66_D" name="Distribučka" />
    <bpmn:messageFlow id="MessageFlow_66_e12" name="Funkčná skúška a protokol" sourceRef="Task_66_t1" targetRef="Participant_66_D" />
    <bpmn:messageFlow id="MessageFlow_66_e13" name="Montáž elektromera" sourceRef="Participant_66_D" targetRef="Event_66_c1" />
