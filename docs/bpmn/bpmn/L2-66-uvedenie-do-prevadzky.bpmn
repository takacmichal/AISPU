        <bpmn:flowNodeRef>Task_66_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Annotation_66_nt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_66_s" name="Revízia v poriadku">
      <bpmn:outgoing>Flow_66_e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_66_g1" name="Väčší zdroj?">
      <bpmn:incoming>Flow_66_e1</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e2</bpmn:outgoing>
      <bpmn:outgoing>Flow_66_e3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_66_t1" name="Vykonať funkčnú skúšku s distribučkou">
      <bpmn:incoming>Flow_66_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_66_j" name="">
      <bpmn:incoming>Flow_66_e3</bpmn:incoming>
      <bpmn:incoming>Flow_66_e4</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_66_t2" name="Pripraviť podklady k zmluve o dodávke">
      <bpmn:incoming>Flow_66_e5</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_66_c1" name="Elektromer namontovaný (do 5 pr. dní)">
      <bpmn:incoming>Flow_66_e6</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_66_c1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_66_c2" name="Oznámenie o pripojení">
      <bpmn:incoming>Flow_66_e7</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_66_c2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_66_t3" name="Spustiť FVE a overiť výrobu">
      <bpmn:incoming>Flow_66_e8</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_66_t4" name="Odovzdať FVE a preberací protokol zákazníkovi">
      <bpmn:incoming>Flow_66_e9</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_66_c3" name="Podpísaný preberací protokol">
      <bpmn:incoming>Flow_66_e10</bpmn:incoming>
      <bpmn:outgoing>Flow_66_e11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_66_c3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_66_x" name="FVE v prevádzke: aktivovať monitoring">
      <bpmn:incoming>Flow_66_e11</bpmn:incoming>
      <bpmn:messageEventDefinition id="MsgDef_66_x" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_66_e1" name="" sourceRef="StartEvent_66_s" targetRef="Gateway_66_g1" />
