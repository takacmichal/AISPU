  <bpmn:collaboration id="Collaboration_68">
    <bpmn:participant id="Participant_68_SolarOps" name="SolarOps (firma)" processRef="Process_68" />
    <bpmn:participant id="Participant_68_Z" name="Zákazník" />
    <bpmn:participant id="Participant_68_M" name="Detekčný systém (monitoring a ML)" />
    <bpmn:messageFlow id="MessageFlow_68_e7" name="Upozornenie: výroba &lt; 85 % očakávanej" sourceRef="Participant_68_M" targetRef="StartEvent_68_s" />
    <bpmn:messageFlow id="MessageFlow_68_e8" name="Label pre ML: falošný poplach" sourceRef="EndEvent_68_fp" targetRef="Participant_68_M" />
    <bpmn:messageFlow id="MessageFlow_68_e9" name="Notifikácia o poruche" sourceRef="Task_68_t2" targetRef="Participant_68_Z" />
  </bpmn:collaboration>
  <bpmn:process id="Process_68" name="SolarOps (firma) – #68 Automatický servis" isExecutable="false">
    <bpmn:documentation>Roly: Obchod (kontrola upozornenia, založenie tiketu), Detekčný systém (monitoring a ML; black-box pool), Zákazník (black-box pool; notifikácia).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_68">
      <bpmn:lane id="Lane_68_lane0" name="Obchod">
        <bpmn:flowNodeRef>StartEvent_68_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_68_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_68_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_68_fp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_68_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallActivity_68_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_68_x</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_68_s" name="Upozornenie na podvýrobu">
      <bpmn:outgoing>Flow_68_e1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_68_s" />
    </bpmn:startEvent>
    <bpmn:task id="Task_68_t1" name="Preveriť upozornenie (dáta, počasie, výpadok komunikácie)">
      <bpmn:incoming>Flow_68_e1</bpmn:incoming>
      <bpmn:outgoing>Flow_68_e2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_68_g" name="Skutočná podvýroba?">
      <bpmn:incoming>Flow_68_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_68_e3</bpmn:outgoing>
      <bpmn:outgoing>Flow_68_e4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_68_fp" name="Falošný poplach zaznamenaný">
      <bpmn:incoming>Flow_68_e3</bpmn:incoming>
      <bpmn:messageEventDefinition id="MsgDef_68_fp" />
    </bpmn:endEvent>
    <bpmn:task id="Task_68_t2" name="Vytvoriť servisný tiket">
      <bpmn:incoming>Flow_68_e4</bpmn:incoming>
      <bpmn:outgoing>Flow_68_e5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="CallActivity_68_t3" name="Servisný proces (#67)" calledElement="Process_67">
      <bpmn:incoming>Flow_68_e5</bpmn:incoming>
      <bpmn:outgoing>Flow_68_e6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_68_x" name="Porucha odstránená">
      <bpmn:incoming>Flow_68_e6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_68_e1" name="" sourceRef="StartEvent_68_s" targetRef="Task_68_t1" />
    <bpmn:sequenceFlow id="Flow_68_e2" name="" sourceRef="Task_68_t1" targetRef="Gateway_68_g" />
    <bpmn:sequenceFlow id="Flow_68_e3" name="nie" sourceRef="Gateway_68_g" targetRef="EndEvent_68_fp" />
    <bpmn:sequenceFlow id="Flow_68_e4" name="áno" sourceRef="Gateway_68_g" targetRef="Task_68_t2" />
    <bpmn:sequenceFlow id="Flow_68_e5" name="" sourceRef="Task_68_t2" targetRef="CallActivity_68_t3" />
    <bpmn:sequenceFlow id="Flow_68_e6" name="" sourceRef="CallActivity_68_t3" targetRef="EndEvent_68_x" />
  </bpmn:process>
