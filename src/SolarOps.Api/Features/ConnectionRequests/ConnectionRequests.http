# Connection requests (#85). Requires a JWT with role Admin/Operator/Sales (create) or any staff role (read).
# Port matches launchSettings.json (http profile).
@baseUrl = http://localhost:5080
@token = paste-access-token-here
@installationId = 00000000-0000-0000-0000-000000000000
@connectionRequestId = 00000000-0000-0000-0000-000000000000

### Create a connection request (state Draft); diagram and owner consent are required.
### File content is not uploaded yet: only attachment metadata is stored.
POST {{baseUrl}}/api/connection-requests
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "installationId": "{{installationId}}",
  "eicCode": "24ZZS12345678901",
  "ratedAcPowerKw": 8,
  "mainBreakerAmps": 25,
  "attachments": [
    { "kind": "SingleLineDiagram", "fileName": "schema.pdf", "contentType": "application/pdf", "sizeBytes": 120000 },
    { "kind": "OwnerConsent", "fileName": "suhlas-vlastnika.pdf", "contentType": "application/pdf", "sizeBytes": 80000 },
    { "kind": "Datasheet", "fileName": "panel-datasheet.pdf", "contentType": "application/pdf", "sizeBytes": 450000 }
  ]
}

### Get a connection request
GET {{baseUrl}}/api/connection-requests/{{connectionRequestId}}
Authorization: Bearer {{token}}
