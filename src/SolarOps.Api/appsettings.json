{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionRequest": {
    "SmallSourceMaxKw": 10.8
  },
  "Weather": {
    "Enabled": true,
    "BaseUrl": "https://api.open-meteo.com/v1/forecast",
    "ApiKey": "",
    "ForecastHours": 48,
    "RefreshIntervalHours": 24,
    "RunOnStartup": true,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 5,
    "TimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "SolarOps",
    "Audience": "SolarOps",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 30
  }
}
