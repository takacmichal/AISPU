# Copy to infra/.env (ignored by git) or let infra/deploy.sh create it. Never commit infra/.env.
# Secrets: generated by deploy.sh on the first run when missing.
SOLAROPS_POSTGRES_PASSWORD=
SOLAROPS_JWT_SIGNING_KEY=
SOLAROPS_ADMIN_PASSWORD=

# Alerts (#168): defaults to the signed-in Azure account.
SOLAROPS_ALERT_EMAIL=

# Images: required for the first deployment, later the deployed ones are kept when empty.
SOLAROPS_API_IMAGE=
SOLAROPS_ML_IMAGE=
SOLAROPS_WEB_IMAGE=

# Only for private images (e.g. a GHCR token with read:packages).
SOLAROPS_REGISTRY_USERNAME=
SOLAROPS_REGISTRY_PASSWORD=
